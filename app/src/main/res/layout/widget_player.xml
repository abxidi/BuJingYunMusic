<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_classic"
    android:clickable="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widgetArt"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_widget_art_classic"
            android:padding="14dp">

            <ImageView
                android:id="@+id/widgetArtIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_art_description"
                android:src="@drawable/ic_music" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/nova_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_empty_title"
                android:textColor="@color/nova_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_empty_meta"
                android:textColor="@color/nova_soft"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/widgetProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_widget_progress" />

                <TextView
                    android:id="@+id/widgetTime"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text="00:00 / --:--"
                    android:textColor="@color/nova_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetPlay"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_widget_play_classic"
                android:clickable="true"
                android:contentDescription="播放"
                android:padding="14dp"
                android:src="@drawable/ic_play" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widgetPrevious"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_widget_button_classic"
                    android:clickable="true"
                    android:contentDescription="上一首"
                    android:padding="8dp"
                    android:src="@drawable/ic_previous" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widgetNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_widget_button_classic"
                android:clickable="true"
                android:contentDescription="下一首"
                android:padding="8dp"
                android:src="@drawable/ic_next" />

            <ImageView
                android:id="@+id/widgetFavorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_widget_button_classic"
                android:clickable="true"
                android:contentDescription="收藏"
                android:padding="8dp"
                android:src="@drawable/ic_heart" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
