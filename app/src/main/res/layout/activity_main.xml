<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player">

    <LinearLayout
        android:id="@+id/playerPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="菜单"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/nova_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/screen_subtitle"
                    android:textColor="@color/nova_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Space
                android:layout_width="46dp"
                android:layout_height="46dp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/discOrbit"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_panel"
            android:padding="28dp">

            <FrameLayout
                android:id="@+id/disc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_disc"
                android:padding="102dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/track_title"
                    android:src="@drawable/ic_music" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/track_title"
            android:textColor="@color/nova_ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/track_meta"
            android:textColor="@color/nova_soft"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/visualizer"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="24dp"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_progress_fill" />

            <View
                android:layout_width="7dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_progress_fill" />

            <View
                android:layout_width="7dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_progress_fill" />

            <View
                android:layout_width="7dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_progress_fill" />

            <View
                android:layout_width="7dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_progress_fill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressRow"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvElapsed"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/nova_muted"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/progressTouchArea"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="播放进度">

                <FrameLayout
                    android:id="@+id/progressTrack"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_progress_track">

                    <View
                        android:id="@+id/progressFill"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_fill" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="03:48"
                android:textColor="@color/nova_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/controlRow"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnMode"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_control_button_active"
                android:clickable="true"
                android:contentDescription="随机播放"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivMode"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_shuffle" />

                <TextView
                    android:id="@+id/tvMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="随机"
                    android:textColor="@color/nova_ink"
                    android:textSize="10sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnPrevious"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="上一首"
                android:padding="15dp"
                android:src="@drawable/ic_previous" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="播放"
                android:padding="21dp"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="下一首"
                android:padding="15dp"
                android:src="@drawable/ic_next" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_favorite_button"
                android:contentDescription="收藏当前音乐"
                android:padding="15dp"
                android:src="@drawable/ic_heart" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/menuDrawer"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drawerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_title"
                        android:textColor="@color/nova_ink"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/menu_subtitle"
                        android:textColor="@color/nova_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCloseDrawer"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_control_button"
                    android:contentDescription="关闭菜单"
                    android:padding="12dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuTabs"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/tabLibrary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_button_active"
                    android:contentDescription="曲库"
                    android:padding="12dp"
                    android:src="@drawable/ic_music" />

                <ImageButton
                    android:id="@+id/tabFavorites"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_button"
                    android:contentDescription="收藏"
                    android:padding="12dp"
                    android:src="@drawable/ic_heart" />

                <ImageButton
                    android:id="@+id/tabFolders"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_button"
                    android:contentDescription="目录"
                    android:padding="12dp"
                    android:src="@drawable/ic_folder" />

                <ImageButton
                    android:id="@+id/tabSettings"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_control_button"
                    android:contentDescription="设置"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelLibrary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="曲库"
                    android:textColor="@color/nova_cyan"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/libraryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="收藏"
                    android:textColor="@color/nova_pink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/favoriteList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_control_button"
                        android:padding="10dp"
                        android:src="@drawable/ic_folder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFolderPath"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="/storage/emulated/0/Music"
                            android:textColor="@color/nova_ink"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFolderCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="读取中"
                            android:textColor="@color/nova_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnPickFolder"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_play_button"
                    android:text="@string/pick_folder"
                    android:textColor="#041218"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <Switch
                    android:id="@+id/switchAutoScan"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="启动自动扫描"
                    android:textColor="@color/nova_ink"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchFavoriteQueue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="默认播放收藏队列"
                    android:textColor="@color/nova_ink"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="暗场动态频谱"
                    android:textColor="@color/nova_ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
