<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_song_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_song_art"
        android:padding="10dp"
        android:src="@drawable/ic_music" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="星际漫游.mp3"
            android:textColor="@color/nova_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Synthwave · 8.6 MB"
            android:textColor="@color/nova_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="03:48"
        android:textColor="@color/nova_soft"
        android:textSize="12sp" />

    <ImageButton
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_favorite_button"
        android:contentDescription="收藏"
        android:padding="8dp"
        android:src="@drawable/ic_heart" />
</LinearLayout>

